# Generate a local value with: openssl rand -hex 32
VENDING_ADMIN_TOKEN=
VENDING_OPERATOR_TOKEN=
VENDING_VIEWER_TOKEN=
VENDING_HOST=127.0.0.1
VENDING_PORT=8080
VENDING_DB=vending-lab.sqlite3
# MQTT adapter (optional): install with pip install -e '.[mqtt]'.
# Remote brokers require TLS. Never put password values in this file or Git.
VENDING_MQTT_BROKER=127.0.0.1
VENDING_MQTT_PORT=1883
VENDING_MQTT_USERNAME=
VENDING_MQTT_PASSWORD=
VENDING_MQTT_TLS=false
VENDING_MQTT_CA_FILE=
VENDING_MQTT_DEVICE_ID={machine_id}
VENDING_MQTT_TIMEOUT=5
# Topics may use {machine_id}; topic wildcards are not accepted by the adapter.
VENDING_MQTT_TELEMETRY_TOPIC=devices/{machine_id}/telemetry
VENDING_MQTT_COMMAND_TOPIC=devices/{machine_id}/commands
VENDING_MQTT_RESULT_TOPIC=devices/{machine_id}/results
